DATABASE_URL="postgresql://devflow:devflow@localhost:5433/devflow"
JWT_SECRET="change-me-to-a-long-random-string"
WEB_ORIGIN="http://localhost:3000"
PORT=4000

# --- GitHub App (optional; the integration is disabled until all are set) ---
# See "GitHub integration" in the root README for how to create the app.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key. Newlines may be written as \n to keep it on one line.
GITHUB_APP_PRIVATE_KEY=
# From the app's "Request user authorization (OAuth)" settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The secret you enter in the app's "Webhook secret" field.
GITHUB_WEBHOOK_SECRET=

# --- Email (optional) ---
# Without SMTP_URL, development prints emails (password reset, invitations)
# to the API console. Example: smtps://user:password@smtp.example.com
SMTP_URL=
EMAIL_FROM="DevFlow <no-reply@example.com>"
# Public web address used in email links (defaults to WEB_ORIGIN).
WEB_URL=

# --- Deployment security ---
# Set to "production" in production: Secure cookies, no email bodies in logs,
# and startup refuses a weak JWT_SECRET or a non-https WEB_ORIGIN.
NODE_ENV=development
# Number of reverse proxies in front of the API (e.g. 1 behind a single load
# balancer). Rate limits use the real client IP only when this is set.
TRUST_PROXY=
